// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "right",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 200,
    },
  },
  "base_keymap": "VSCode",
  "buffer_font_size": 13,
  "collaboration_panel": {
    "button": false,
  },
  "colorize_brackets": true,
  "edit_predictions": {
    "mode": "subtle",
  },
  "format_on_save": "on",
  "git_panel": {
    "dock": "left",
    "group_by": "staging",
    "tree_view": true,
  },
  "linked_edits": true,
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "tab_size": 2,
  "tabs": {
    "git_status": true,
  },
  "theme": {
    "dark": "Min Dark (Blurred)",
    "light": "Min Light (Blurred)",
    "mode": "system",
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "ui_font_size": 13,
}
