[user]
    name = Andrei Saliba
    email = andreisaliba@gmail.com
[alias]
    a = add
    aa = add .
    c = commit
    ca = commit --amend
    cane = commit --amend --no-edit
    cnv = commit --no-verify
    p = push
    pfl = push --force-with-lease
    pnv = push --no-verify
    pnvfl = push --no-verify --force-with-lease
    r = rebase
    s = status
[branch]
    sort = -committerdate
[core]
    eol = lf
    autocrlf = false
    excludesFile = ~/.gitignore_global
[diff]
    algorithm = histogram
    colorMoveed = plain
    memonicPrefix = true
    updateRefs = true
[help]
    autocorrect = prompt
[init]
    defaultBranch = main
[merge]
    conflictStyle = zdiff3
[rebase]
    autoStash = true
    committerDataIsAuthorDate = true
    updateRefs = true
[remote]
    pushDefault = origin
[rerere]
    enabled = true
[push]
    autoSetupRemote = true
    default = simple
[pull]
    ff = only
[tag]
    sort = version=refname

# Delta
[delta]
    navigate = true
    side-by-side = true
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only

[include]
    path = ~/.gitconfig.local
